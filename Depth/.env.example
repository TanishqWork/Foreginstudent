# Copy to .env. Paste your Supabase PostgreSQL connection string from Connect.
# Use the session pooler on port 5432 if your network does not support IPv6.
# Percent-encode reserved characters in the password. Keep SSL enabled.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
COOKIE_SECURE=false
# Optional: only required when using the backend LLM component.
OPENAI_API_KEY=
FREE_ASSESSMENT_MAX_OUTPUT_TOKENS=16384
# Export TEST_DATABASE_URL in your shell for integration tests, using a
# separate PostgreSQL database ending in _test.
# Never point this at the application database named postgres.
# TEST_DATABASE_URL=postgresql+psycopg://TEST_USER:TEST_PASSWORD@TEST_HOST:5432/statement_studio_test?sslmode=require

