# Copy to .env. Paste your Supabase PostgreSQL connection string from Connect.
# Use the session pooler on port 5432 if your network does not support IPv6.
# Percent-encode reserved characters in the password. Keep SSL enabled.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Supabase Auth configuration, kept on the backend. Configure the project's
# JWT expiry to 86400 seconds; FastAPI also enforces an absolute one-day limit.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only administrative key for importing existing accounts/admin work.
# Never put this key or the database URL in Surface or browser storage.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
COOKIE_SECURE=false
# Optional: only required when using the backend LLM component.
OPENAI_API_KEY=
FREE_ASSESSMENT_MAX_OUTPUT_TOKENS=16384
# Configure SMTP in the Supabase dashboard, not in this application's frontend.
# Built-in email is limited to organization-team addresses and 2 emails/hour.
# Local Site URL: http://localhost:5173
# Allowed recovery redirect: http://localhost:5173/api/auth/recovery/callback
# Allowed signup confirmation redirect: http://localhost:5173/api/auth/confirmation/callback
# Keep signup email confirmation enabled; both PKCE flows keep verifier cookies HttpOnly.
# Export TEST_DATABASE_URL in your shell for integration tests, using a
# separate PostgreSQL database ending in _test.
# Never point this at the application database named postgres.
# TEST_DATABASE_URL=postgresql+psycopg://TEST_USER:TEST_PASSWORD@TEST_HOST:5432/statement_studio_test?sslmode=require

